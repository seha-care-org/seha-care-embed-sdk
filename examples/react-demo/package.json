{
  "name": "@seha-care/embed-sdk-react-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:bundle": "npm run typecheck && vite build --sourcemap && node scripts/check-client-bundle.mjs"
  },
  "dependencies": {
    "@seha-care/embed-sdk": "file:../..",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/express": "^5.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
