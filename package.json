{
  "name": "@seha-care/embed-sdk",
  "version": "0.1.0",
  "description": "Secure server and browser clients, plus React, Next.js, and Angular components for Seha Care embedded sessions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seha-care-org/seha-care-embed-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/seha-care-org/seha-care-embed-sdk/issues"
  },
  "homepage": "https://github.com/seha-care-org/seha-care-embed-sdk#readme",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "browser": null,
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./nextjs": {
      "types": "./dist/nextjs/index.d.ts",
      "react-server": "./dist/nextjs/index.js",
      "browser": null,
      "default": "./dist/nextjs/index.js"
    },
    "./angular": {
      "types": "./dist/angular/types/seha-care-embed-sdk-angular.d.ts",
      "import": "./dist/angular/fesm2022/seha-care-embed-sdk-angular.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@angular/common": "^21.0.0 || ^22.0.0",
    "@angular/core": "^21.0.0 || ^22.0.0",
    "@angular/platform-browser": "^21.0.0 || ^22.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "server-only": "^0.0.1"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/platform-browser": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "server-only": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/build-frameworks.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "check:server-formats": "node scripts/check-server-formats.mjs",
    "check:server-examples": "node scripts/smoke-server-examples.mjs",
    "verify": "npm run typecheck && npm test && npm run check:server-formats",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler-cli": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "ng-packagr": "^21.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "zone.js": "^0.16.3"
  }
}